{
  "schemaVersion": 1,
  "project": "CarFinder",
  "version": "5.2.3",
  "githubSource": "v5.2.3",
  "zipPrefix": "CarFinder-",
  "port": 0,
  "packageChanges": false,
  "commit": "Release CarFinder v0.0.1",
  "i18n": {
    "enabled": false,
    "folder": "src/i18n",
    "masterLanguage": "en-GB",
    "defaultLanguage": "en-GB",
    "languages": [
      "en-GB"
    ]
  },
  "app": {
    "include": [
      "index.html",
      "css/*",
      "css/**/*",
      "js/*",
      "js/**/*",
      "assets/*",
      "assets/**/*"
    ],
    "exclude": [
      "app/*",
      "app/**/*",
      "admin/*",
      "admin/**/*",
      "config/*",
      "config/**/*",
      "data/*",
      "data/**/*",
      "scripts/*",
      "scripts/**/*",
      "exports/*",
      "exports/**/*",
      "logs/*",
      "logs/**/*",
      "requirements.txt",
      "run_*.sh",
      "run_*.ps1",
      "bx.html"
    ]
  }
}
