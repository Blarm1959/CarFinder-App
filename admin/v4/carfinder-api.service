[Unit]
Description=CarFinder v4 API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/carfinder
Environment=PYTHONUNBUFFERED=1
Environment=CARFINDER_COOKIE_SECURE=0
ExecStart=/opt/carfinder/.venv/bin/uvicorn app.v4_api:app --host 127.0.0.1 --port 8502
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
